# Copy to /opt/synapse-dev/shared/deploy.env. Every line is optional.

# BRANCH=bdren-dev
# GH_REPO=nafew0/synapse
# REPO_URL=https://github.com/nafew0/synapse.git
# KEEP_RELEASES=3
# HEALTH_URL=http://127.0.0.1:3080/health
# HEALTH_TIMEOUT=180
# PUBLIC_URL=https://dev-chat.bdren.ai

# Check runs that must pass before a commit is deployed (job names in
# .github/workflows/bdren-dev.yml, separated by |). Matrix jobs match by prefix.
# Use "Build and type check" alone to deploy even when unit tests fail.
# REQUIRED_CHECKS="Build and type check|Unit tests"
# SKIP_CI_GATE=0

# Optional classic token with the public_repo scope. Raises the GitHub API
# limit and makes each deploy show as a "dev-server deploy" status on the commit.
# GITHUB_TOKEN=

# The same scripts deploy other apps when pointed at another DEV_ROOT, e.g. the
# admin panel (/opt/synapse-admin-dev/shared/deploy.env):
# REPO_URL=https://github.com/nafew0/synapse-admin.git
# GH_REPO=nafew0/synapse-admin
# APP=synapse-admin-dev
# HEALTH_URL=http://172.19.0.1:3001/health
# SHARED_PATHS=".env logs"
# INSTALL_CMD="bun install --frozen-lockfile"
# BUILD_CMD="bun run build"
