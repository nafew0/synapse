<!doctype html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{appName}}</title>
<!--[if mso]>
<xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>
<![endif]-->
<style>
  /* Client resets */
  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
  body { margin: 0 !important; padding: 0 !important; width: 100% !important; }
  a { color: #0E4B4A; }

  /* Phones */
  @media only screen and (max-width: 620px) {
    .sheet { width: 100% !important; }
    .pad { padding-left: 24px !important; padding-right: 24px !important; }
    .stack { display: block !important; width: 100% !important; text-align: left !important; }
    .stack-team { padding: 14px 0 0 0 !important; border-left: 0 !important; text-align: left !important; }
    .h1 { font-size: 31px !important; line-height: 38px !important; }
    .lede { font-size: 15px !important; line-height: 25px !important; }
    .btn-table { width: 100% !important; }
    .btn-wrap { display: block !important; width: 100% !important; }
    .btn-a { display: block !important; text-align: center !important; }
    .btn-note { display: block !important; padding: 12px 0 0 0 !important; text-align: center !important; }
    .label-col { display: block !important; width: 100% !important; padding-bottom: 3px !important; }
    .value-col { display: block !important; width: 100% !important; }
  }
</style>
</head>
<body style="margin: 0; padding: 0; background-color: #EFE7DA;">

<!-- Preheader: shown in the inbox preview, hidden in the email -->
<div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #EFE7DA;">
  Set your password and your {{#if institutionName}}{{institutionName}} {{/if}}account on {{appName}} is ready.{{#if expiresOn}} The link is open until {{expiresOn}}.{{/if}}
  &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
</div>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #EFE7DA;">
  <tr>
    <td align="center" style="padding: 40px 12px;">

      <table role="presentation" class="sheet" cellpadding="0" cellspacing="0" border="0" width="600" style="width: 600px; max-width: 600px; background-color: #FCF9F4; border: 1px solid #E1D6C4;">

        <!-- Accent band -->
        <tr>
          <td style="height: 5px; line-height: 5px; font-size: 0; background-color: #0E4B4A;">&nbsp;</td>
        </tr>

        <!-- Masthead -->
        <tr>
          <td class="pad" style="padding: 30px 44px 24px 44px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td class="stack" valign="middle">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="44" valign="middle" style="width: 44px; padding-right: 14px;">
                        <a href="{{appUrl}}" target="_blank" style="text-decoration: none;"><img src="{{appUrl}}/assets/synapse-email-icon.png" width="44" height="44" alt="{{appName}}" style="display: block; width: 44px; height: 44px; border: 0;"></a>
                      </td>
                      <td valign="middle" style="font-family: Georgia, 'Times New Roman', serif; font-size: 23px; line-height: 27px; font-weight: bold; letter-spacing: 3px; text-transform: uppercase; color: #12302E;">
                        {{appName}}
                        <div style="padding-top: 4px; font-family: Helvetica, Arial, sans-serif; font-size: 10px; line-height: 15px; font-weight: normal; letter-spacing: 1.4px; text-transform: uppercase; color: #6A6458;">Smarter work with affordable AI</div>
                      </td>
                    </tr>
                  </table>
                </td>
                <td class="stack stack-team" valign="middle" align="right" style="border-left: 1px solid #E1D6C4; padding-left: 16px; font-family: Helvetica, Arial, sans-serif; font-size: 10px; line-height: 16px; letter-spacing: 1px; color: #6A6458; text-align: right;">
                  DEVELOPED BY THE<br>BdREN INNOVATION TEAM
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="height: 1px; line-height: 1px; font-size: 0; background-color: #E8DECD;">&nbsp;</td>
        </tr>

        <!-- Letter -->
        <tr>
          <td class="pad" style="padding: 40px 44px 0 44px; font-family: Helvetica, Arial, sans-serif;">
            <div style="font-size: 11px; line-height: 16px; letter-spacing: 1.6px; text-transform: uppercase; color: #A04A28;">Invitation{{#if institutionName}} &middot; {{institutionName}}{{/if}}</div>
            <div style="padding-top: 20px; font-family: Georgia, 'Times New Roman', serif; font-size: 19px; line-height: 26px; color: #2F3A37;">Hi{{#if name}} {{name}}{{/if}},</div>
            <h1 class="h1" style="margin: 10px 0 0 0; font-family: Georgia, 'Times New Roman', serif; font-size: 38px; line-height: 46px; font-weight: normal; color: #12302E;">{{#if institutionName}}Your university has a seat waiting for you.{{else}}A seat is waiting for you.{{/if}}</h1>
            <p class="lede" style="margin: 22px 0 0 0; font-size: 16px; line-height: 27px; color: #45504C;">{{appName}} is an AI workspace built by the {{#if orgUrl}}<a href="{{orgUrl}}" target="_blank" style="color: #0E4B4A; text-decoration: underline;">BdREN Innovation Team</a>{{else}}BdREN Innovation Team{{/if}} for universities across Bangladesh. Set a password and the account below is yours &mdash; nothing to install, nothing to pay for.</p>
          </td>
        </tr>

        <!-- Invitation details -->
        <tr>
          <td class="pad" style="padding: 34px 44px 0 44px; font-family: Helvetica, Arial, sans-serif;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td width="118" valign="middle" style="font-size: 11px; line-height: 16px; letter-spacing: 1.6px; color: #6A6458; white-space: nowrap;">YOUR INVITATION</td>
                <td valign="middle" style="padding-left: 14px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="height: 1px; line-height: 1px; font-size: 0; background-color: #E8DECD;">&nbsp;</td></tr></table>
                </td>
              </tr>
            </table>

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top: 6px;">
{{#if email}}
              <tr>
                <td class="label-col" width="122" valign="top" style="padding: 15px 16px 15px 0; font-size: 11px; line-height: 20px; letter-spacing: 1.3px; color: #6A6458;">ACCOUNT</td>
                <td class="value-col" valign="top" style="padding: 15px 0; font-size: 16px; line-height: 22px; font-weight: bold; color: #1B2A28; word-break: break-all;">{{email}}</td>
              </tr>
              <tr><td colspan="2" style="height: 1px; line-height: 1px; font-size: 0; background-color: #EDE4D5;">&nbsp;</td></tr>
{{/if}}
{{#if institutionName}}
              <tr>
                <td class="label-col" width="122" valign="top" style="padding: 15px 16px 15px 0; font-size: 11px; line-height: 20px; letter-spacing: 1.3px; color: #6A6458;">INSTITUTION</td>
                <td class="value-col" valign="top" style="padding: 15px 0; font-size: 16px; line-height: 22px; font-weight: bold; color: #1B2A28;">{{institutionName}}</td>
              </tr>
              <tr><td colspan="2" style="height: 1px; line-height: 1px; font-size: 0; background-color: #EDE4D5;">&nbsp;</td></tr>
{{/if}}
{{#if expiresOn}}
              <tr>
                <td class="label-col" width="122" valign="top" style="padding: 15px 16px 15px 0; font-size: 11px; line-height: 20px; letter-spacing: 1.3px; color: #6A6458;">OPEN BEFORE</td>
                <td class="value-col" valign="top" style="padding: 15px 0; font-size: 16px; line-height: 22px; font-weight: bold; color: #1B2A28;">{{expiresOn}}<span style="font-weight: normal; color: #6A6458;">, after which the link expires</span></td>
              </tr>
              <tr><td colspan="2" style="height: 1px; line-height: 1px; font-size: 0; background-color: #EDE4D5;">&nbsp;</td></tr>
{{/if}}
            </table>
          </td>
        </tr>

        <!-- Call to action -->
        <tr>
          <td class="pad" style="padding: 28px 44px 0 44px; font-family: Helvetica, Arial, sans-serif;">
            <table role="presentation" class="btn-table" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="btn-wrap" bgcolor="#0E4B4A" style="background-color: #0E4B4A; border-radius: 4px;">
                  <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{inviteLink}}" style="height:56px;v-text-anchor:middle;width:212px;" arcsize="7%" stroke="f" fillcolor="#0E4B4A"><w:anchorlock/><center style="color:#FCF9F4;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;"><![endif]-->
                  <a class="btn-a" href="{{inviteLink}}" target="_blank" style="display: inline-block; padding: 17px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 22px; font-weight: bold; color: #FCF9F4; text-decoration: none; border-radius: 4px;">Set your password</a>
                  <!--[if mso]></center></v:roundrect><![endif]-->
                </td>
                <td class="btn-note" valign="middle" style="padding-left: 20px; font-size: 13px; line-height: 20px; color: #6A6458;">Takes under a minute.<br>The link works once.</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- What you can do -->
        <tr>
          <td class="pad" style="padding: 42px 44px 0 44px; font-family: Helvetica, Arial, sans-serif;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td width="176" valign="middle" style="font-size: 11px; line-height: 16px; letter-spacing: 1.6px; color: #6A6458; white-space: nowrap;">WHAT YOU CAN DO WITH IT</td>
                <td valign="middle" style="padding-left: 14px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="height: 1px; line-height: 1px; font-size: 0; background-color: #E8DECD;">&nbsp;</td></tr></table>
                </td>
              </tr>
            </table>

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top: 14px;">
              <tr>
                <td width="26" valign="top" style="padding: 6px 12px 6px 0; font-family: Georgia, 'Times New Roman', serif; font-size: 13px; line-height: 22px; color: #A04A28;">01</td>
                <td valign="top" style="padding: 6px 0; font-size: 15px; line-height: 22px; color: #35403D;">Draft, edit and mark up documents</td>
              </tr>
              <tr>
                <td width="26" valign="top" style="padding: 6px 12px 6px 0; font-family: Georgia, 'Times New Roman', serif; font-size: 13px; line-height: 22px; color: #A04A28;">02</td>
                <td valign="top" style="padding: 6px 0; font-size: 15px; line-height: 22px; color: #35403D;">Build spreadsheets and work through the numbers</td>
              </tr>
              <tr>
                <td width="26" valign="top" style="padding: 6px 12px 6px 0; font-family: Georgia, 'Times New Roman', serif; font-size: 13px; line-height: 22px; color: #A04A28;">03</td>
                <td valign="top" style="padding: 6px 0; font-size: 15px; line-height: 22px; color: #35403D;">Put a presentation together from your notes</td>
              </tr>
              <tr>
                <td width="26" valign="top" style="padding: 6px 12px 6px 0; font-family: Georgia, 'Times New Roman', serif; font-size: 13px; line-height: 22px; color: #A04A28;">04</td>
                <td valign="top" style="padding: 6px 0; font-size: 15px; line-height: 22px; color: #35403D;">Read, search and fill in PDF files</td>
              </tr>
              <tr>
                <td width="26" valign="top" style="padding: 6px 12px 6px 0; font-family: Georgia, 'Times New Roman', serif; font-size: 13px; line-height: 22px; color: #A04A28;">05</td>
                <td valign="top" style="padding: 6px 0; font-size: 15px; line-height: 22px; color: #35403D;">Generate images for your slides and papers</td>
              </tr>
            </table>

            <p style="margin: 30px 0 0 0; font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-size: 17px; line-height: 26px; color: #2F3A37;">See you on {{appName}},<br>BdREN Innovation Team</p>
          </td>
        </tr>

        <!-- Fine print -->
        <tr>
          <td class="pad" style="padding: 32px 44px 36px 44px; font-family: Helvetica, Arial, sans-serif;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="height: 1px; line-height: 1px; font-size: 0; background-color: #E8DECD;">&nbsp;</td></tr></table>
            <p style="margin: 20px 0 0 0; font-size: 12px; line-height: 19px; color: #6A6458;">Button not working? Open <a href="{{inviteLink}}" target="_blank" style="color: #0E4B4A; text-decoration: underline; word-break: break-all;">{{inviteLink}}</a></p>
            <p style="margin: 7px 0 0 0; font-size: 12px; line-height: 19px; color: #6A6458;">{{#if email}}Sent to {{email}}. {{/if}}If you were not expecting this, ignore it &mdash; no account exists until the link is opened.{{#if supportEmail}} Questions go to <a href="mailto:{{supportEmail}}" style="color: #0E4B4A; text-decoration: underline;">{{supportEmail}}</a>.{{/if}}</p>
            <p style="margin: 7px 0 0 0; font-size: 12px; line-height: 19px; color: #6A6458;">{{appName}} is operated by BdREN, Bangladesh Research and Education Network{{#if orgUrl}} &mdash; <a href="{{orgUrl}}" target="_blank" style="color: #0E4B4A; text-decoration: underline;">{{orgLabel}}</a>{{/if}}</p>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
