<!doctype html>
<html>
  <body style="font-family: Arial, sans-serif; color: #222; font-size: 14px">
    <h2>Issue report</h2>
    {{#if context.code}}
      <p>Error <strong>{{context.code}}</strong>{{#if context.reference}} · ref <strong>{{context.reference}}</strong>{{/if}}</p>
    {{else}}
      <p>General report (not tied to a specific error).</p>
    {{/if}}
    {{#if shownMessage}}
      <p>Message shown to the user: <em>{{shownMessage}}</em></p>
    {{/if}}

    <h3>Reporter</h3>
    <ul>
      {{#if reporter.name}}<li>Name: {{reporter.name}}</li>{{/if}}
      {{#if reporter.email}}<li>Email: {{reporter.email}}</li>{{/if}}
      {{#if reporter.username}}<li>Username: {{reporter.username}}</li>{{/if}}
      <li>User ID: {{reporter.id}}</li>
      {{#if reporter.role}}<li>Role: {{reporter.role}}</li>{{/if}}
      {{#if reporter.institution}}<li>Institution: {{reporter.institution}}{{#if reporter.tenantId}} ({{reporter.tenantId}}){{/if}}</li>{{/if}}
    </ul>

    {{#if description}}
      <h3>What they wrote</h3>
      <div style="white-space: pre-wrap; border-left: 3px solid #ccc; padding-left: 8px">{{description}}</div>
    {{/if}}

    {{#if summaries.length}}
      <h3>Error details</h3>
      {{#each summaries}}
        <div style="border: 1px solid #ddd; padding: 8px; margin-bottom: 8px">
          <p><strong>{{code}}</strong> · request_id {{requestId}}{{#if reference}} (ref {{reference}}){{/if}}</p>
          <ul>
            {{#if status}}<li>Status: {{status}}</li>{{/if}}
            {{#if message}}<li>Message: {{message}}</li>{{/if}}
            {{#if route}}<li>Route: {{route}}</li>{{/if}}
            {{#if provider}}<li>Provider: {{provider}}</li>{{/if}}
            {{#if model}}<li>Model: {{model}}</li>{{/if}}
            {{#if at}}<li>Time: {{at}}</li>{{/if}}
          </ul>
          {{#if stack}}
            <pre style="white-space: pre-wrap; font-size: 12px; background: #f6f6f6; padding: 6px">{{stack}}</pre>
          {{/if}}
        </div>
      {{/each}}
    {{/if}}
    {{#each missing}}
      <p>No cached details for request_id {{this}} — search the server logs for it.</p>
    {{/each}}

    {{#if recentErrors.length}}
      <h3>Recent errors in this session</h3>
      <ul>
        {{#each recentErrors}}
          <li>{{code}}{{#if occurredAt}} · {{occurredAt}}{{/if}}{{#if page}} · {{page}}{{/if}}{{#if requestId}} · request_id {{requestId}}{{/if}}</li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if lastMessage}}
      <h3>Last message (shared by the user)</h3>
      <div style="white-space: pre-wrap; border-left: 3px solid #ccc; padding-left: 8px">{{lastMessage}}</div>
    {{/if}}

    <h3>Context</h3>
    <ul>
      {{#if context.requestId}}<li>Request ID: {{context.requestId}}</li>{{/if}}
      {{#if context.page}}<li>Page: {{context.page}}</li>{{/if}}
      {{#if context.conversationId}}<li>Conversation ID: {{context.conversationId}}</li>{{/if}}
      {{#if context.messageId}}<li>Message ID: {{context.messageId}}</li>{{/if}}
      {{#if context.occurredAt}}<li>Reported at (client): {{context.occurredAt}}</li>{{/if}}
      <li>Server time: {{context.serverTime}}</li>
      {{#if context.environment}}<li>Environment: {{context.environment}}</li>{{/if}}
      <li>App version (server): {{context.appVersion}}</li>
      {{#if context.clientAppVersion}}<li>App version (client): {{context.clientAppVersion}}</li>{{/if}}
      {{#if context.browser}}<li>Browser: {{context.browser}}</li>{{/if}}
      {{#if context.language}}<li>Language: {{context.language}}</li>{{/if}}
      {{#if context.timezone}}<li>Timezone: {{context.timezone}}</li>{{/if}}
      {{#if context.screen}}<li>Screen: {{context.screen}}</li>{{/if}}
    </ul>
  </body>
</html>
